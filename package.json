{
  "name": "boly",
  "version": "1.3.5",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "tiagowhuber",
  "scripts": {
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run typecheck && electron-vite build && electron-builder --dir",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win",
    "build:mac": "npm run typecheck && electron-vite build && electron-builder --mac",
    "build:linux": "npm run typecheck && electron-vite build && electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tiagowhuber/boly-desktop-app.git"
  },
  "publish": {
    "provider": "github",
    "releaseType": "release",
    "private": false,
    "owner": "tiagowhuber",
    "repo": "boly-desktop-app"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.0.1",
    "axios": "^1.7.2",
    "dotenv": "^16.5.0",
    "echarts": "^5.6.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "pinia": "^2.1.7",
    "tailwindcss": "^4.0.1",
    "three": "^0.174.0",
    "unity-webgl": "^3.5.5",
    "vue": "^3.4.29",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.3.3",
    "vue-star-rating": "^2.1.0",
    "vue3-carousel": "^0.5.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.2"
  }
}
